# Compose reads .env for interpolation; the application only reads a dotenv
# file when DOTENV_PATH (or -dotenv) explicitly selects one.
# Generate a signing secret: openssl rand -base64 48
APP_AUTH_TOKEN_SECRET=replace-with-a-random-value
APP_DATABASE_PASSWORD=local-postgres-password
APP_RABBITMQ_PASSWORD=local-rabbit-password
APP_RABBITMQ_USER=ecommerce

# Apply database schema changes with Atlas before starting the API.
APP_APP_GIN_MODE=release
APP_APP_PRINT_CONFIG=false
APP_APP_EXPOSE_DEV_MSG=false
APP_OTEL_ENABLED=false
APP_ELASTICSEARCH_ENABLED=false
APP_LOG_CONSOLE_LEVEL=info
APP_LOG_FILE_LEVEL=
APP_LOG_FILENAME=
APP_ORDER_MQ_TTL_MS=30000

# Optional container registry/build mirrors and published ports:
# IMAGE_REPOSITORY=
# BUILD_REGISTRY_PREFIX=
# APP_HTTP_PORT=10000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
