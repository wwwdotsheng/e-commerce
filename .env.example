# 复制成 .env（已在 .gitignore 里）。
# 代码里 config.Init() 会调 godotenv.Load() 读这个文件，
# 用于本地开发时提供环境变量，避免每次手动 export。
#
# ★ 集群部署不要用这个文件 —— 值由 Secret 经 env 注入，见 k8s/README-secrets.md
#
# 配置里的默认值都取「安全的那一侧」（不打印配置、不暴露 devMsg、
# 不自动建表），下面这些是在本地开发时把它们打开。

# ── 必填：没有默认值，Validate() 会拒绝空值和示例值 ──────────────
# 生成：openssl rand -base64 48 | tr -d '\n'
APP_AUTH_TOKEN_SECRET=replace-with-a-random-value
APP_DATABASE_PASSWORD=
APP_RABBITMQ_PASSWORD=

# ── 本地开发才打开 ───────────────────────────────────────────
# 用 AutoMigrate 建表（生产走 migrations/，不打开）
APP_DATABASE_AUTO_MIGRATE=true
# 启动时打印完整配置（含密码，仅排查用）
# APP_APP_PRINT_CONFIG=true
# 响应里带 devMsg（含原始错误，仅排查用）
# APP_APP_EXPOSE_DEV_MSG=true

# ── 可选 ───────────────────────────────────────────────────
# 镜像仓库前缀。留空 = Docker Hub
# IMAGE_REPOSITORY=harbor.internal/dockerhub/
# gin 运行模式。不设 = debug
# GIN_MODE=release
